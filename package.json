{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "timer",
  "title": "Timer",
  "description": "Create timers and get notified",
  "categories": [],
  "license": "MIT",
  "author": "HarshNarayanJha",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "timer",
      "title": "Timer",
      "subtitle": "Start a new timer or view active timers",
      "description": "Starts a new timer with duration and an optional name and view the timers history",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "presets",
      "type": "textfield",
      "required": false,
      "title": "Timer Presets",
      "description": "Comma-separated presets (e.g., 5m Tea, 25m Pomodoro)",
      "default": "5m Tea, 25m Pomodoro"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "format": "biome format --write src",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "yarn"
  ]
}
